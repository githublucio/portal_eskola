[Unit]
Description=Portal ESTVP Atauro (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/portal_eskola
EnvironmentFile=/var/www/portal_eskola/.env
ExecStart=/var/www/portal_eskola/.venv/bin/gunicorn -c /var/www/portal_eskola/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
