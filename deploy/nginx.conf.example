# Nginx site for Portal ESTVP Atauro.
# Copy to /etc/nginx/sites-available/portal-eskola and enable with:
#   sudo ln -s /etc/nginx/sites-available/portal-eskola /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream portal_eskola {
    server 127.0.0.1:8001;
}

server {
    listen 80;
    listen [::]:80;
    server_name escola.example.tl;

    client_max_body_size 20M;

    location /static/ {
        alias /var/www/portal_eskola/staticfiles/;
    }

    location /media/ {
        alias /var/www/portal_eskola/media/;
    }

    location / {
        proxy_pass http://portal_eskola;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}

# After obtaining a certificate (certbot --nginx -d escola.example.tl),
# enable HTTPS flags in .env:
#   DEBUG=False
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
#   SECURE_SSL_REDIRECT=True
#   CSRF_TRUSTED_ORIGINS=https://escola.example.tl
